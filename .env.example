# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000; the original Go service used 8080).
PORT=8080
# SQLite database file path (absolute or relative to the app root).
DATABASE_PATH=storage/production.sqlite3
# Public address of this site, for canonical links, the sitemap and the feed.
DOCS_BASE_URL=https://docs.arcline.it

# --- Sign-in through Nexus (needed for "My docs" and the admin area) ---
NEXUS_ISSUER=https://nexus.arcline.it
# From the Docs entry under Connected Apps in Nexus.
NEXUS_CLIENT_ID=
NEXUS_CLIENT_SECRET=

# --- Client pages ---
# This user can manage client pages, as can anyone with the Nexus "admin" role.
ADMIN_EMAIL=
# Billing's SQLite database, opened read-only to look up each customer's plan.
BILLING_DB_PATH=../billing/storage/production.sqlite3
