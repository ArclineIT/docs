<header class="site-header" data-controller="nav">
  <div class="container site-header__inner">
    <%= link_to root_path, class: "logo", aria: { label: "Arcline Docs home" } do %>
      <%= render "shared/logo", size: 28 %>
      <span class="logo__word">Arcline</span>
    <% end %>
    <span class="site-header__tag">Docs</span>

    <div class="search" data-controller="search" data-search-url-value="<%= search_index_path %>"
         data-action="keydown->search#keydown focusout->search#hideLater">
      <input type="search" class="search__input" placeholder="Search docs (⌘K)" autocomplete="off" aria-label="Search documentation"
             data-search-target="input" data-action="input->search#query focus->search#query">
      <div class="search__results" data-search-target="results" hidden></div>
    </div>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
            data-nav-target="toggle" data-action="nav#toggle">
      <%= icon :menu, size: 22 %>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="nav" id="site-nav" aria-label="Main" data-nav-target="menu">
      <% if signed_in? %>
        <%= nav_link "My docs", client_pages_path %>
        <%= nav_link "Admin", admin_pages_path if current_viewer.admin? %>
      <% end %>

      <button class="theme-toggle" type="button" data-controller="theme" data-action="theme#toggle">
        <%= icon :contrast, size: 18 %>
        <span class="theme-toggle__label">Switch theme</span>
      </button>

      <% if signed_in? %>
        <%= button_to "Log out", logout_path, method: :delete, class: "btn btn--ghost btn--sm" %>
      <% elsif Nexus.configured? %>
        <%= link_to "Sign in", sign_in_path, class: "btn btn--ghost btn--sm" %>
      <% end %>
    </nav>
  </div>
</header>
